---
import { getCollection } from "astro:content";

import SiteLayout from "../layouts/SiteLayout.astro";

const posts = (await getCollection("blog"))
	.sort(
		(a, b) =>
			b.data.pubDate.valueOf() -
			a.data.pubDate.valueOf()
	)
	.slice(0, 3);
---

<SiteLayout
	title="The Network Stalwart | Josh Richards"
	description="The Network Stalwart — real-world thoughts, lessons and experiences from designing, deploying and troubleshooting enterprise networks and security."
>

	<section class="hero">

		<div class="container hero-inner">

			<p class="eyebrow">
				NETWORK &amp; SECURITY
			</p>

			<p class="intro">
				Real-world thoughts, lessons and experiences from designing,
				deploying and troubleshooting enterprise networks and security.
			</p>

			<div class="topics">
				<span>Fortinet</span>
				<span>Cisco</span>
				<span>Microsoft</span>
				<span>Azure</span>
				<span>SASE</span>
				<span>SD-WAN</span>
				<span>Enterprise Networking</span>
			</div>

		</div>

	</section>


	<section class="section">

		<div class="container">

			<p class="section-label">
				LATEST WRITING
			</p>

			<h2 class="section-title">
				Notes from the field.
			</h2>

			<div class="writing-grid">

				{
					posts.map((post) => (

						<article class="writing-card">

							<div>

								<p class="article-date">
									{
										post.data.pubDate.toLocaleDateString(
											"en-GB",
											{
												day: "numeric",
												month: "long",
												year: "numeric",
											}
										)
									}
								</p>

								<h3>
									<a href={`/blog/${post.id}/`}>
										{post.data.title}
									</a>
								</h3>

								<p class="writing-description">
									{post.data.description}
								</p>

							</div>

							{
								post.data.tags?.length > 0 && (

									<div class="tags">

										{
											post.data.tags.map((tag) => (
												<span class="tag">
													{tag}
												</span>
											))
										}

									</div>

								)
							}

						</article>

					))
				}

			</div>

			<div class="all-writing">

				<a href="/blog/" class="text-link-dark">
					All writing →
				</a>

			</div>

		</div>

	</section>

</SiteLayout>


<style>

	.hero {
		padding: 110px 0 120px;

		background:
			linear-gradient(
				135deg,
				#ffffff 0%,
				#f6f9fa 100%
			);
	}


	.hero-inner {
		max-width: 850px;

		margin-left: auto;
		margin-right: auto;

		text-align: center;
	}


	.eyebrow {
		margin: 0 0 18px;

		font-size: 0.8rem;
		font-weight: 800;

		letter-spacing: 0.16em;

		color: var(--teal);
	}


	.intro {
		max-width: 720px;

		margin: 32px auto 0;

		font-size: 1.2rem;

		color: #4f5a6b;
	}


	.topics {
		margin: 30px 0 0;

		display: flex;
		flex-wrap: wrap;
		justify-content: center;

		gap: 10px;
	}


	.topics span {
		padding: 7px 13px;

		border: 1px solid var(--border);
		border-radius: 100px;

		background: white;

		font-size: 0.87rem;
		font-weight: 600;
	}


	.writing-grid {
		display: grid;
		gap: 24px;
	}


	.writing-card {
		padding: 32px 34px;

		display: flex;
		justify-content: space-between;
		align-items: flex-start;

		gap: 30px;

		border-left: 5px solid var(--orange);

		background: var(--light-background);
	}


	.article-date {
		margin: 0 0 9px;

		color: var(--teal);

		font-size: 0.8rem;
		font-weight: 800;

		letter-spacing: 0.08em;

		text-transform: uppercase;
	}


	.writing-card h3 {
		margin: 0 0 9px;

		font-size: 1.4rem;
		line-height: 1.25;
	}


	.writing-card h3 a {
		color: var(--navy);
		text-decoration: none;
	}


	.writing-card h3 a:hover {
		color: var(--teal);
	}


	.writing-description {
		max-width: 720px;

		margin: 0;

		color: var(--muted);
	}


	.all-writing {
		margin-top: 32px;
	}


	.text-link-dark {
		color: var(--navy);

		font-weight: 700;
		text-decoration: none;
	}


	.text-link-dark:hover {
		color: var(--teal);
	}


	@media (max-width: 700px) {

		.hero {
			padding: 75px 0 85px;
		}


		.writing-card {
			padding: 28px 25px;

			flex-direction: column;

			gap: 20px;
		}

	}

</style>
