---
import "../styles/global.css";

import SiteHeader from "../components/Header.astro";
import AboutSection from "../components/AboutSection.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
	title: string;
	description: string;
	showAbout?: boolean;
}

const {
	title,
	description,
	showAbout = true,
} = Astro.props;
---

<!doctype html>

<html lang="en">

	<head>

		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width"
		/>

		<title>{title}</title>

		<meta
			name="description"
			content={description}
		/>

		<link
			rel="icon"
			type="image/png"
			href="/network-stalwart-favicon.png"
		/>

	</head>

	<body>

		<SiteHeader />

		<main>
			<slot />
		</main>

		{showAbout && <AboutSection />}

		<SiteFooter />

	</body>

</html>
